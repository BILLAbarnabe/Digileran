{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js", "/manifest.webmanifest"]
      }
    },
    {
      "name": "static-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.woff2", "/*.svg", "/*.png", "/*.jpg"]
      }
    },
    {
      "name": "course-content",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "urls": ["https://api.digilearn.local/courses/**", "https://api.digilearn.local/media/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-read",
      "urls": ["/api/courses/**", "/api/campaigns/**"],
      "cacheConfig": { "strategy": "freshness", "timeout": "10s", "maxSize": 50, "maxAge": "1d" }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**"]
}
